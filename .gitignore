# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# IDEs and editors
.idea/
.vscode/

# env files - NEVER commit real credentials
.env.local
.env.development.local
.env.test.local
.env.production.local
# Allow the example template to be committed:
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
